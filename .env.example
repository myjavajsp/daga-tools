# ===== 数据库配置（本地 MySQL）=====
DB_HOST=127.0.0.1
DB_PORT=3306
# 本地开发库账号（请按本地实际修改，勿填入生产密码）
DB_USER=daga_clone
# 必填：缺失时 initDatabase() 会拒绝启动（不再内置兜底口令）。
DB_PASSWORD=
DB_NAME=daga_clone

# ===== 安全 =====
# JWT 签名密钥（必须设置，缺失时 auth 中间件会拒绝启动）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ===== 后台管理 =====
# 首次初始化时若两者均设置，会种入该管理员；缺省不种子、仅告警（不再内置默认弱口令）。
# 生产务必使用强口令，勿用示例值。
ADMIN_USER=
ADMIN_PASS=
# 后台登录路径片段（混淆用）。不设置则回退到代码内默认值，生产建议显式设为随机串。
# 生成方式：node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
ADMIN_PATH=

# ===== 站点 =====
SITE_URL=http://localhost:3001
PORT=3001

# ===== 影片搜索上游（SSRF 白名单）=====
# 搜索接口上游地址，逗号分隔可配置多个备用源；只有列表内的 host 会被请求，
# 其余一律拒绝（防 SSRF）。留空或配置失效主机时搜索接口优雅降级返回空列表。
SEARCH_API_BASE=https://search.video.iqiyi.com

# ===== 短视频去水印上游（可选）=====
# diadi 网关 app_secret；仅当 parse_interfaces 表内无 type='short' 行、需内置兜底时才用到。
# 正式线路应写入 DB 表，此处仅为无 DB short 行时的应急兜底，源码不再内置明文密钥。
DIADI_APP_SECRET=
